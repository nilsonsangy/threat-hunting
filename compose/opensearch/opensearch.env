# Variaveis do caminho OPCIONAL OpenSearch (profile `opensearch`).
#
# Este arquivo documenta e centraliza as variaveis do servico opcional. Ele NAO
# e necessario para o caminho pandas: os exercicios e testes
# rodam 100% offline, sem OpenSearch (R12.3).
#
# Como usar (opcional): carregue estas variaveis no seu shell antes de rodar o
# ingest a partir do host, por exemplo no PowerShell:
#   Get-Content compose/opensearch/opensearch.env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]*)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) }
#   }
# ou, em bash:  set -a; . compose/opensearch/opensearch.env; set +a

# -----------------------------------------------------------------------------
# Cliente de ingest (scripts/ingest_opensearch.py)
# -----------------------------------------------------------------------------
# Host:porta do OpenSearch visto pelo cliente de ingest.
#   - A partir do HOST (fora do compose):      localhost:9200
#   - De DENTRO da rede do compose (serv. lab): opensearch:9200
OPENSEARCH_HOST=localhost:9200

# Diretorio de dados a ingerir (sample = Dataset_Amostra; real = Dataset_Real).
THLAB_DATASET=sample

# -----------------------------------------------------------------------------
# Servico OpenSearch (espelha o docker-compose.yml; config minima de laboratorio)
# -----------------------------------------------------------------------------
# Single-node, security plugin desabilitado por conveniencia de laboratorio.
# NAO use em producao.
discovery.type=single-node
DISABLE_SECURITY_PLUGIN=true
DISABLE_INSTALL_DEMO_CONFIG=true
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
